# Copiá este archivo como .env y completá los valores reales.
# El .env NO se commitea.

# Postgres (Neon). La connection string se copia del dashboard de neon.tech.
# IMPORTANTE: usar el endpoint POOLED (el host lleva "-pooler"). Contra el endpoint
# directo, el schema engine de Prisma falla con P1001 aunque la app conecte bien.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (el frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# --- Sprint 4: Mercado Pago ---
# Access Token de "Tus integraciones > BinomaEcommerceApi > Credenciales".
# En desarrollo usar el de PRUEBA, que empieza con TEST-.
# Sin esta variable el pedido se crea igual, pero no se genera el link de pago.
MP_ACCESS_TOKEN=

# Mercado Pago RECHAZA localhost en back_urls y notification_url: tienen que ser
# HTTPS y accesibles desde internet. En desarrollo se resuelven con ngrok:
#
#   ngrok http 3000   ->  pegar la URL https en PUBLIC_API_URL
#   ngrok http 5173   ->  pegar la URL https en PUBLIC_WEB_URL
#
# Si quedan vacías, la preferencia se crea igual pero sin retorno al sitio y sin
# webhook. Sirve para probar que el link de pago se genera.
PUBLIC_WEB_URL=
PUBLIC_API_URL=

# --- Sprint 5: Cloudinary + auth admin ---
# CLOUDINARY_URL=
# JWT_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
