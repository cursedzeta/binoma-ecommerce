# Copiá este archivo como .env y completá los valores reales.
# El .env NO se commitea.

# Postgres (Neon). La connection string se copia del dashboard de neon.tech.
# Usar la variante "pooled" para la app y agregar ?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-xxxx.aws.neon.tech/binoma?sslmode=require"

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (el frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# --- Sprint 4: Mercado Pago ---
# MP_ACCESS_TOKEN=

# --- Sprint 5: Cloudinary + auth admin ---
# CLOUDINARY_URL=
# JWT_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
